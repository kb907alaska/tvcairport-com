---
export interface Props {
  severity?: 'information' | 'advisory' | 'weather' | 'emergency';
  title?: string;
  message?: string;
  actionUrl?: string;
  actionText?: string;
  isDismissible?: boolean;
}

const {
  severity = 'advisory',
  title = 'TRAVEL ADVISORY · AIRPORT ACCESS & CONSTRUCTION',
  message = 'Terminal Expansion construction is underway. Please allow an extra 15 minutes for parking and drop-off access.',
  actionUrl = '/gates-to-the-future',
  actionText = 'View Passenger Detours →',
  isDismissible = true
} = Astro.props;
---

<aside 
  id="airport-alert-banner"
  class={`airport-alert alert-${severity}`}
  role="region"
  aria-label="Airport Operational Alert"
>
  <div class="container alert-content">
    <div class="alert-icon-wrapper">
      {severity === 'emergency' && (
        <svg class="alert-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="22" height="22">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
      )}
      {severity === 'weather' && (
        <svg class="alert-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="22" height="22">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z"/>
        </svg>
      )}
      {(severity === 'advisory' || severity === 'information') && (
        <svg class="alert-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" width="22" height="22">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      )}
    </div>

    <div class="alert-text">
      <strong class="alert-title">{title}</strong>
      <span class="alert-message">{message}</span>
    </div>

    <div class="alert-actions">
      {actionUrl && (
        <a href={actionUrl} class="alert-link">{actionText}</a>
      )}
      {isDismissible && (
        <button 
          type="button" 
          class="alert-close-btn"
          aria-label="Dismiss Airport Alert"
          onclick="document.getElementById('airport-alert-banner').style.display='none'"
        >
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" width="18" height="18">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      )}
    </div>
  </div>
</aside>

<style>
  .airport-alert {
    width: 100%;
    padding: 10px 0;
    font-size: 0.875rem;
    line-height: 1.4;
    transition: all 0.3s ease;
  }

  .alert-advisory {
    background-color: #FFFBEB;
    color: #92400E;
    border-bottom: 2px solid #F59E0B;
  }

  .alert-emergency {
    background-color: #FEF2F2;
    color: #991B1B;
    border-bottom: 3px solid #DC2626;
  }

  .alert-weather {
    background-color: #EFF6FF;
    color: #1E40AF;
    border-bottom: 2px solid #3B82F6;
  }

  .alert-information {
    background-color: #F8FAFC;
    color: #334155;
    border-bottom: 1px solid #CBD5E1;
  }

  .alert-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .alert-icon-wrapper {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .alert-text {
    flex: 1;
    min-width: 280px;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .alert-title {
    font-weight: 700;
    letter-spacing: 0.03em;
    font-size: 0.8rem;
    text-transform: uppercase;
  }

  .alert-message {
    font-weight: 400;
  }

  .alert-actions {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-shrink: 0;
  }

  .alert-link {
    font-weight: 700;
    text-decoration: underline;
    color: inherit;
    font-size: 0.85rem;
  }

  .alert-link:hover {
    opacity: 0.8;
  }

  .alert-close-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: inherit;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    border-radius: 4px;
  }

  .alert-close-btn:hover {
    background: rgba(0, 0, 0, 0.08);
  }
</style>
