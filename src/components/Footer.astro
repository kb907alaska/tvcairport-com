---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" id="site-footer">
  <!-- Upper Footer CTA -->
  <div class="footer-cta-strip">
    <div class="container cta-container">
      <div class="cta-text">
        <h2 class="cta-title">Flying from Cherry Capital Airport?</h2>
        <p class="cta-desc">Check real-time arrivals, departures, parking rates, and security wait times before you leave.</p>
      </div>
      <div class="cta-buttons">
        <a href="/flights" class="btn btn-primary">Check Live Flights →</a>
        <a href="/parking-transportation" class="btn btn-outline-light">Parking Calculator</a>
      </div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="footer-main">
    <div class="container footer-grid">
      <!-- Column 1: Brand & Contact -->
      <div class="footer-col brand-col">
        <div class="footer-logo">
          <img src="/images/logos/tvc-logo-footer.png" alt="Cherry Capital Airport TVC Logo" class="official-footer-logo" width="180" height="40" />
        </div>
        <p class="footer-address">
          Northwest Regional Airport Authority<br />
          727 Fly Don't Drive<br />
          Traverse City, Michigan 49686
        </p>

        <div class="phone-numbers">
          <div class="phone-item">
            <span class="phone-label">Airport Information:</span>
            <a href="tel:2319472250" class="phone-link">(231) 947-2250</a>
          </div>
          <div class="phone-item">
            <span class="phone-label">24/7 Operations / Emergency:</span>
            <a href="tel:2319472250" class="phone-link emergency-phone">(231) 947-2250 Ext 1</a>
          </div>
        </div>

        <div class="social-links">
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="TVC Airport on Facebook">
            <svg fill="currentColor" viewBox="0 0 24 24" width="20" height="20"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.891h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
          </a>
          <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" aria-label="TVC Airport on X Twitter">
            <svg fill="currentColor" viewBox="0 0 24 24" width="20" height="20"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="TVC Airport on Instagram">
            <svg fill="currentColor" viewBox="0 0 24 24" width="20" height="20"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
        </div>
      </div>

      <!-- Column 2: Travel & Flights -->
      <div class="footer-col">
        <h3 class="footer-heading">Passenger Travel</h3>
        <ul class="footer-nav">
          <li><a href="/flights">Live Flight Status</a></li>
          <li><a href="/flights/airlines">Airlines Serving TVC</a></li>
          <li><a href="/flights/nonstop-destinations">Nonstop Route Map</a></li>
          <li><a href="/parking-transportation">Parking Rates & Calculator</a></li>
          <li><a href="/parking-transportation">Rental Cars & Ground Transport</a></li>
          <li><a href="/airport-guide">Terminal Amenities & Map</a></li>
          <li><a href="/airport-guide/accessibility">TSA Cares & Accessibility</a></li>
          <li><a href="/lost-and-found">Lost & Found Service</a></li>
          <li><a href="/faq">Passenger FAQ</a></li>
        </ul>
      </div>

      <!-- Column 3: Regional Gateway & Projects -->
      <div class="footer-col">
        <h3 class="footer-heading">Explore & Growth</h3>
        <ul class="footer-nav">
          <li><a href="/visit-northern-michigan">Visit Northern Michigan</a></li>
          <li><a href="/why-tvc">Why Fly TVC</a></li>
          <li><a href="/business-travel">Corporate Travel Services</a></li>
          <li><a href="/gates-to-the-future">Gates to the Future Expansion</a></li>
          <li><a href="/news">News & Advisories</a></li>
          <li><a href="/proposal">FOURAK Proposal Overview</a></li>
        </ul>
      </div>

      <!-- Column 4: NRAA Governance & Bids -->
      <div class="footer-col">
        <h3 class="footer-heading">Airport Authority (NRAA)</h3>
        <ul class="footer-nav">
          <li><a href="/nraa">About the Authority</a></li>
          <li><a href="/nraa/meetings">Board Meetings & Agendas</a></li>
          <li><a href="/documents">Public Document Repository</a></li>
          <li><a href="/business-opportunities">RFPs, Bids & Procurement</a></li>
          <li><a href="/careers">Careers & Employment</a></li>
          <li><a href="/contact">Contact Airport Administration</a></li>
          <li><a href="/board-portal">Secure Board Portal Login</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Bottom Legal & Compliance Strip -->
  <div class="footer-bottom">
    <div class="container bottom-container">
      <div class="legal-text">
        © {currentYear} Northwest Regional Airport Authority (NRAA). All rights reserved.
      </div>
      <div class="legal-links">
        <a href="/airport-guide/accessibility">Accessibility (WCAG 2.2 AA)</a>
        <a href="/documents">Public Records</a>
        <a href="#">Privacy Policy</a>
        <a href="#">Terms of Use</a>
        <a href="#" onclick="window.toggleSearchModal(); return false;">Search Site</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-navy-dark);
    color: #94A3B8;
    margin-top: auto;
  }

  /* CTA Strip */
  .footer-cta-strip {
    background: linear-gradient(90deg, #1E3E62 0%, #0B192C 100%);
    border-top: 4px solid var(--color-cherry);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 32px 0;
  }

  .cta-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .cta-title {
    color: white;
    font-size: 1.5rem;
    margin-bottom: 4px;
  }

  .cta-desc {
    color: #CBD5E1;
    font-size: 0.95rem;
  }

  .cta-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .btn-outline-light {
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
  }

  .btn-outline-light:hover {
    background: rgba(255, 255, 255, 0.1);
    color: white;
  }

  /* Footer Main Grid */
  .footer-main {
    padding: 60px 0 40px;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
    }
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }

  .footer-tvc-badge {
    background-color: var(--color-cherry);
    color: white;
    font-weight: 800;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.85rem;
  }

  .footer-brand-title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.2rem;
    color: white;
  }

  .footer-address {
    font-size: 0.88rem;
    line-height: 1.6;
    margin-bottom: 20px;
    color: #CBD5E1;
  }

  .phone-numbers {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 20px;
    font-size: 0.85rem;
  }

  .phone-label {
    display: block;
    color: #94A3B8;
  }

  .phone-link {
    color: white;
    font-weight: 600;
  }

  .phone-link:hover {
    color: var(--color-cherry);
  }

  .emergency-phone {
    color: #F87171;
  }

  .social-links {
    display: flex;
    gap: 12px;
  }

  .social-links a {
    color: #94A3B8;
    background: rgba(255, 255, 255, 0.05);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .social-links a:hover {
    background: var(--color-cherry);
    color: white;
  }

  .footer-heading {
    color: white;
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 20px;
    position: relative;
    padding-bottom: 8px;
  }

  .footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 30px;
    height: 2px;
    background-color: var(--color-cherry);
  }

  .footer-nav {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-nav a {
    color: #CBD5E1;
    font-size: 0.88rem;
  }

  .footer-nav a:hover {
    color: white;
    padding-left: 4px;
  }

  /* Bottom Strip */
  .footer-bottom {
    background-color: #070F1B;
    padding: 20px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.8rem;
  }

  .bottom-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .legal-links {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .legal-links a {
    color: #94A3B8;
  }

  .legal-links a:hover {
    color: white;
  }
</style>
