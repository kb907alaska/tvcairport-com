<script>
  (window as any).switchFidsTab = function(type: 'arr' | 'dep') {
    const arrBtn = document.getElementById('fids-arr-btn');
    const depBtn = document.getElementById('fids-dep-btn');
    const arrPanel = document.getElementById('fids-arr-panel');
    const depPanel = document.getElementById('fids-dep-panel');

    if (type === 'arr') {
      arrBtn?.classList.add('active');
      depBtn?.classList.remove('active');
      if (arrPanel) arrPanel.style.display = 'block';
      if (depPanel) depPanel.style.display = 'none';
    } else {
      depBtn?.classList.add('active');
      arrBtn?.classList.remove('active');
      if (depPanel) depPanel.style.display = 'block';
      if (arrPanel) arrPanel.style.display = 'none';
    }
  };
</script>
