---
import Layout from '../../layouts/Layout.astro';
import { AMENITIES_DATA } from '../../data/amenities';
---

<Layout
  title="Airport Guide & Terminal Amenities · TVC Cherry Capital Airport"
  description="Explore TVC terminal amenities: dining, newsstands, lactation suites, pet relief areas, TSA PreCheck, Wi-Fi, and terminal layout maps."
>
  <div class="page-header-bg">
    <div class="container">
      <div class="breadcrumb">
        <a href="/">Home</a> / <span>Airport Guide</span>
      </div>
      <h1 class="page-title">Terminal Guide & Amenities</h1>
      <p class="page-intro">Find passenger dining, shopping, family lactation suites, pet relief, and airport services.</p>
    </div>
  </div>

  <section class="guide-section">
    <div class="container">
      <div class="app-subnav">
        <a href="/airport-guide" class="subnav-btn active">☕ Terminal Amenities</a>
        <a href="/airport-guide/accessibility" class="subnav-btn">♿ Accessibility & TSA Cares</a>
      </div>

      <!-- Interactive "Where Am I?" Terminal Wayfinding Pathfinder -->
      <div class="wayfinding-card tvc-card mb-8">
        <div class="flex justify-between items-center flex-wrap gap-4 mb-4">
          <div>
            <span class="eyebrow">TERMINAL WAYFINDING PATHFINDER</span>
            <h2 class="text-xl font-bold text-navy-dark">🧭 "Where Am I?" Interactive Step-by-Step Wayfinder</h2>
          </div>
          <label class="flex items-center gap-2 cursor-pointer bg-slate-100 px-3 py-1.5 rounded-md border">
            <input type="checkbox" id="accessible-mode-toggle" onchange="window.updateWayfindingPath()" />
            <span class="text-xs font-bold text-navy-dark">♿ Accessible Route Mode</span>
          </label>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="wayfind-start" class="text-xs font-bold text-slate-500 uppercase block mb-1">Starting Point:</label>
            <select id="wayfind-start" class="w-full p-2 border rounded-md font-bold text-slate-700" onchange="window.updateWayfindingPath()">
              <option value="curb">Main Terminal Entrance Curb</option>
              <option value="ticketing">Airline Check-in & Ticketing Counter</option>
              <option value="tsa">TSA Main Security Checkpoint</option>
              <option value="gates">Post-Security Concourse Gate 3</option>
              <option value="baggage">Baggage Claim Hall Door 2</option>
            </select>
          </div>

          <div>
            <label for="wayfind-end" class="text-xs font-bold text-slate-500 uppercase block mb-1">Destination:</label>
            <select id="wayfind-end" class="w-full p-2 border rounded-md font-bold text-slate-700" onchange="window.updateWayfindingPath()">
              <option value="tsa">TSA Security Checkpoint</option>
              <option value="gates" selected>Concourse Gates 1–5 & Dining</option>
              <option value="baggage">Baggage Claim & Rental Cars</option>
              <option value="lactation">Mamava Lactation Suite</option>
              <option value="pet">Service Animal Pet Relief Area</option>
            </select>
          </div>
        </div>

        <!-- Calculated Wayfinding Directions Output -->
        <div class="wayfinding-result-box mt-4 p-4 bg-slate-50 rounded-lg border border-slate-200" id="wayfinding-output">
          <span class="text-xs font-bold text-blue-800 uppercase block mb-1">Step-by-Step Route Guidance</span>
          <p class="text-sm font-semibold text-navy-dark" id="wayfind-text">From Ticketing → Walk 40 feet forward to TSA Security Checkpoint. Proceed through screening to Gates 1–5.</p>
          <span class="text-xs text-muted mt-2 block" id="wayfind-access-text">Standard Direct Walk · 2 minutes · Elevators & Ramp Available</span>
        </div>
      </div>

      <!-- Amenity Categories Filter -->
      <div class="filter-toolbar tvc-card">
        <div class="category-buttons">
          <button type="button" class="cat-btn active" onclick="window.filterAmenities('ALL')">All Amenities</button>
          <button type="button" class="cat-btn" onclick="window.filterAmenities('Dining & Drinks')">Dining & Drinks</button>
          <button type="button" class="cat-btn" onclick="window.filterAmenities('Shopping & Gifts')">Shopping & Gifts</button>
          <button type="button" class="cat-btn" onclick="window.filterAmenities('Accessibility & Family')">Family & Pets</button>
          <button type="button" class="cat-btn" onclick="window.filterAmenities('Services & Comfort')">Services & TSA</button>
        </div>
      </div>

      <!-- Amenity Cards Grid -->
      <div class="amenities-grid">
        {AMENITIES_DATA.map((item) => (
          <div class="amenity-card tvc-card" data-category={item.category}>
            <div class="amenity-img-box">
              <img src={item.image} alt={item.name} loading="lazy" />
              <span class="security-badge">{item.securityState}</span>
            </div>

            <div class="amenity-body">
              <div class="amenity-head">
                <span class="amenity-cat">{item.category}</span>
                <h3 class="amenity-title">{item.name}</h3>
                <span class="amenity-loc">📍 {item.location}</span>
              </div>

              <p class="amenity-desc">{item.description}</p>
              <div class="amenity-hours">⏱️ <strong>Hours:</strong> {item.hours}</div>

              <div class="feature-pills">
                {item.features.map((feat) => (
                  <span class="feature-pill">✓ {feat}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-header-bg { background: linear-gradient(135deg, var(--color-navy-dark) 0%, var(--color-navy) 100%); color: white; padding: 40px 0; }
  .breadcrumb { font-size: 0.85rem; color: #94A3B8; margin-bottom: 10px; }
  .breadcrumb a { color: #CBD5E1; }
  .page-title { font-size: 2.5rem; color: white; margin-bottom: 8px; }
  .page-intro { color: #CBD5E1; font-size: 1.05rem; }

  .guide-section { padding: 40px 0 80px; }

  .app-subnav { display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap; }
  .subnav-btn { background-color: white; border: 1px solid var(--color-border); padding: 10px 18px; border-radius: var(--radius-md); font-weight: 700; color: var(--color-navy-dark); font-size: 0.9rem; text-decoration: none; }
  .subnav-btn.active { background-color: var(--color-navy); color: white; }

  .filter-toolbar { margin-bottom: 32px; }
  .category-buttons { display: flex; gap: 8px; flex-wrap: wrap; }
  .cat-btn { padding: 8px 16px; border: 1px solid var(--color-border); background: white; border-radius: var(--radius-full); font-size: 0.85rem; font-weight: 700; color: var(--color-navy-dark); cursor: pointer; }
  .cat-btn.active { background: var(--color-navy); color: white; border-color: var(--color-navy); }

  .amenities-grid { display: grid; grid-template-columns: repeat(1, 1fr); gap: 24px; }
  @media (min-width: 640px) { .amenities-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .amenities-grid { grid-template-columns: repeat(3, 1fr); } }

  .amenity-card { padding: 0; overflow: hidden; display: flex; flex-direction: column; }
  .amenity-img-box { position: relative; height: 180px; }
  .amenity-img-box img { width: 100%; height: 100%; object-fit: cover; }

  .security-badge { position: absolute; top: 12px; right: 12px; background: var(--color-navy-dark); color: white; padding: 4px 10px; border-radius: var(--radius-full); font-size: 0.72rem; font-weight: 800; text-transform: uppercase; }

  .amenity-body { padding: 20px; display: flex; flex-direction: column; flex: 1; }
  .amenity-cat { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; color: var(--color-cherry); }
  .amenity-title { font-size: 1.3rem; color: var(--color-navy-dark); margin: 4px 0; }
  .amenity-loc { font-size: 0.82rem; color: var(--color-text-muted); font-weight: 600; display: block; margin-bottom: 12px; }

  .amenity-desc { font-size: 0.88rem; color: var(--color-text-muted); line-height: 1.5; margin-bottom: 12px; }
  .amenity-hours { font-size: 0.82rem; color: var(--color-navy-dark); margin-bottom: 16px; }

  .feature-pills { display: flex; flex-wrap: wrap; gap: 4px; margin-top: auto; }
  .feature-pill { background: var(--color-sand); border: 1px solid var(--color-border); padding: 2px 8px; border-radius: 4px; font-size: 0.75rem; color: var(--color-navy); font-weight: 600; }
</style>

<script>
  (window as any).filterAmenities = function(cat: string) {
    const btns = document.querySelectorAll('.cat-btn');
    btns.forEach(b => b.classList.remove('active'));

    const activeBtn = Array.from(btns).find(b => b.textContent?.trim().includes(cat) || (cat === 'ALL' && b.textContent?.includes('All')));
    activeBtn?.classList.add('active');

    const cards = document.querySelectorAll('.amenity-card');
    cards.forEach(card => {
      const category = card.getAttribute('data-category');
      if (cat === 'ALL' || category === cat) {
        (card as HTMLElement).style.display = 'flex';
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  };

  (window as any).updateWayfindingPath = function() {
    const start = (document.getElementById('wayfind-start') as HTMLSelectElement)?.value;
    const end = (document.getElementById('wayfind-end') as HTMLSelectElement)?.value;
    const isAccessible = (document.getElementById('accessible-mode-toggle') as HTMLInputElement)?.checked;

    const textElem = document.getElementById('wayfind-text');
    const accessElem = document.getElementById('wayfind-access-text');

    if (!textElem || !accessElem) return;

    if (start === end) {
      textElem.innerText = 'You are already at your destination!';
      accessElem.innerText = 'No walking required.';
      return;
    }

    let route = 'Walk forward through main hall following overhead terminal signs.';
    let accessInfo = 'Level ground floor walking · 1 to 2 minutes';

    if (start === 'curb' && end === 'gates') {
      route = 'Main Entrance Curb → Enter Glass Doors → Turn Right to TSA Security Checkpoint → Pass Screening to Concourse Gates 1–5.';
    } else if (start === 'ticketing' && end === 'gates') {
      route = 'Ticketing Counters → Walk 50 feet straight to TSA Security Checkpoint → Screened Concourse Area.';
    } else if (start === 'gates' && end === 'baggage') {
      route = 'Concourse Gates → Walk past Cherry Capital Grill → Exit Security Glass Doors → Turn Left into Baggage Claim Hall.';
    } else if (end === 'lactation') {
      route = 'Pass TSA Security → Turn right towards Gate 3 → Mamava Lactation Suite is located adjacent to Restrooms.';
      accessInfo = 'ADA accessible lockable suite with power & changing table.';
    } else if (end === 'pet') {
      route = 'Exit Baggage Claim Door 2 → Turn Right onto Outdoor Pedestrian Sidewalk → Pet Relief Turf Area is 30 yards ahead.';
      accessInfo = 'Accessible concrete ramp pathway with artificial turf and waste disposal.';
    }

    if (isAccessible) {
      accessInfo += ' ♿ Accessible Route Active: Elevator & Automatic Door Access Verified.';
    }

    textElem.innerText = route;
    accessElem.innerText = accessInfo;
  };
</script>
