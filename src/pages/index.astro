<script>
  // Tab controller for Homepage Live Flight Board
  (window as any).switchFlightTab = function(type: 'arrivals' | 'departures') {
    const arrivalsBtn = document.getElementById('tab-arrivals-btn');
    const departuresBtn = document.getElementById('tab-departures-btn');
    const arrivalsPanel = document.getElementById('arrivals-panel');
    const departuresPanel = document.getElementById('departures-panel');

    if (type === 'arrivals') {
      arrivalsBtn?.classList.add('active');
      arrivalsBtn?.setAttribute('aria-selected', 'true');
      departuresBtn?.classList.remove('active');
      departuresBtn?.setAttribute('aria-selected', 'false');

      if (arrivalsPanel) arrivalsPanel.style.display = 'block';
      if (departuresPanel) departuresPanel.style.display = 'none';
    } else {
      departuresBtn?.classList.add('active');
      departuresBtn?.setAttribute('aria-selected', 'true');
      arrivalsBtn?.classList.remove('active');
      arrivalsBtn?.setAttribute('aria-selected', 'false');

      if (departuresPanel) departuresPanel.style.display = 'block';
      if (arrivalsPanel) arrivalsPanel.style.display = 'none';
    }
  };

  (window as any).filterHomeFlights = function() {
    const query = (document.getElementById('home-flight-filter') as HTMLInputElement)?.value.toLowerCase();
    const rows = document.querySelectorAll('.flight-row');

    rows.forEach(row => {
      const code = row.getAttribute('data-code')?.toLowerCase() || '';
      if (code.includes(query)) {
        (row as HTMLElement).style.display = '';
      } else {
        (row as HTMLElement).style.display = 'none';
      }
    });
  };
</script>
