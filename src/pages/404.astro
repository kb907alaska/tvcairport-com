---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 Page Not Found · TVC Cherry Capital Airport"
  description="The requested page could not be located. Use search or quick links to return to TVC flight status, parking, or NRAA documents."
>
  <section class="error-section">
    <div class="container text-center">
      <div class="error-code">404</div>
      <h1 class="error-title">Looks like this route changed.</h1>
      <p class="error-desc">The page or document you are searching for may have moved or been updated in our digital portal.</p>

      <div class="error-search-box">
        <input 
          type="search" 
          placeholder="What can we help you find? (e.g. parking, flights, meetings)..." 
          onkeydown="if(event.key==='Enter'){ window.runQuickSearch(this.value); }"
        />
        <button type="button" class="btn btn-primary" onclick="window.toggleSearchModal(true)">Search Site</button>
      </div>

      <div class="error-recovery-links">
        <a href="/" class="btn btn-navy">Return to Airport Home</a>
        <a href="/flights" class="btn btn-outline">Check Live Flights</a>
        <a href="/parking-transportation" class="btn btn-outline">Parking Rates</a>
        <a href="/documents" class="btn btn-outline">NRAA Documents</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .error-section { padding: 100px 0; background: var(--color-sand); min-height: 70vh; display: flex; align-items: center; }
  .text-center { text-align: center; }
  .error-code { font-family: var(--font-heading); font-size: 6rem; font-weight: 800; color: var(--color-cherry); line-height: 1; margin-bottom: 12px; }
  .error-title { font-size: 2.5rem; color: var(--color-navy-dark); margin-bottom: 12px; }
  .error-desc { font-size: 1.1rem; color: var(--color-text-muted); max-width: 600px; margin: 0 auto 32px; }

  .error-search-box { display: flex; justify-content: center; gap: 10px; max-width: 540px; margin: 0 auto 40px; flex-wrap: wrap; }
  .error-search-box input { flex: 1; min-width: 260px; padding: 12px 16px; border: 1px solid var(--color-border); border-radius: var(--radius-md); outline: none; font-size: 0.95rem; }

  .error-recovery-links { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
</style>
